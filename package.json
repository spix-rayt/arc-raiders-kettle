{
  "name": "arc-raiders-kettle",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "preprocess-images": "npx tsx src/preprocessing/images.ts",
    "preprocess-arcraiders-data": "npx tsx src/preprocessing/arcraiders-data.ts",
    "preprocess-all": "npm run preprocess-arcraiders-data && npm run preprocess-images",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@unhead/vue": "^2.0.19",
    "jimp": "^1.6.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "gh-pages": "^6.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-sitemap": "^0.8.2",
    "vue-tsc": "^3.1.0"
  }
}
